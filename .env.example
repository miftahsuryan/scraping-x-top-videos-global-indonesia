# X/Twitter authentication cookies
# Diperlukan untuk scraping (bukan untuk download mode)
# Lihat README.md untuk cara mendapatkan cookie ini
X_AUTH_TOKEN=your_auth_token_here
X_CT0=your_ct0_here

# Set to false untuk melihat browser (debugging)
HEADLESS=true

# TwitterSaver.net API credentials (from site HTML source)
# These expire periodically — update from twittersaver.net page source
TWITTERSAVER_API_TOKEN=
TWITTERSAVER_API_EXPIRATION=

# DeepSeek API key (for generate-content scripts)
DEEPSEEK_API_KEY=sk-
